@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Edit Opportunity - " + Model.OpportunityName;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h4 class="fw-bold m-0"><i class="fa-solid fa-pen text-warning me-2"></i>Edit Opportunity</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" asp-route-id="@Model.OpportunityId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="OpportunityId" />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="OpportunityName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="OpportunityName" class="form-control" required />
                        <span asp-validation-for="OpportunityName" class="text-danger fs-7"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="CustomerId" class="form-label fw-semibold"></label>
                            <select asp-for="CustomerId" class="form-select">
                                <option value="">-- Select Customer (Optional) --</option>
                                @if (ViewBag.Customers != null)
                                {
                                    foreach (var c in (List<AcxiomCRM.Models.Customer>)ViewBag.Customers)
                                    {
                                        <option value="@c.CustomerId" selected="@(Model.CustomerId == c.CustomerId)">@c.CustomerName (@c.CustomerCode)</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="LeadId" class="form-label fw-semibold"></label>
                            <select asp-for="LeadId" class="form-select">
                                <option value="">-- Select Lead (Optional) --</option>
                                @if (ViewBag.Leads != null)
                                {
                                    foreach (var l in (List<AcxiomCRM.Models.Lead>)ViewBag.Leads)
                                    {
                                        <option value="@l.LeadId" selected="@(Model.LeadId == l.LeadId)">@l.LeadName (@l.LeadCode)</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Amount" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Amount" type="number" step="0.01" min="0.01" class="form-control" required />
                            <span asp-validation-for="Amount" class="text-danger fs-7"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Probability" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="Probability" type="number" min="0" max="100" class="form-control" required />
                            <span asp-validation-for="Probability" class="text-danger fs-7"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Stage" class="form-label fw-semibold"></label>
                            <select asp-for="Stage" class="form-select">
                                <option value="Qualification">Qualification</option>
                                <option value="Proposal">Proposal</option>
                                <option value="Negotiation">Negotiation</option>
                                <option value="Won">Won</option>
                                <option value="Lost">Lost</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="ExpectedCloseDate" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <input asp-for="ExpectedCloseDate" type="date" class="form-control" required />
                            <span asp-validation-for="ExpectedCloseDate" class="text-danger fs-7"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AssignedTo" class="form-label fw-semibold"></label>
                        <select asp-for="AssignedTo" class="form-select">
                            @if (ViewBag.Users != null)
                            {
                                foreach (var u in (List<AcxiomCRM.Models.ApplicationUser>)ViewBag.Users)
                                {
                                    <option value="@u.Id" selected="@(Model.AssignedTo == u.Id)">@u.FullName (@u.Email)</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-success px-4"><i class="fa-solid fa-save me-1"></i> Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
