@model AcxiomCRM.Models.Opportunity
@{
    ViewData["Title"] = "Opportunity Details - " + Model.OpportunityName;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                <h4 class="fw-bold m-0"><i class="fa-solid fa-briefcase text-success me-2"></i>@Model.OpportunityName</h4>
                <span class="badge bg-success px-3 py-2">@Model.Stage</span>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 fs-6">
                    <dt class="col-sm-4 text-muted">Customer / Lead:</dt>
                    <dd class="col-sm-8 fw-semibold">@(Model.Customer?.CustomerName ?? Model.Lead?.LeadName ?? "N/A")</dd>

                    <dt class="col-sm-4 text-muted">Opportunity Amount:</dt>
                    <dd class="col-sm-8 text-success fw-bold fs-5">$@Model.Amount.ToString("N2")</dd>

                    <dt class="col-sm-4 text-muted">Win Probability:</dt>
                    <dd class="col-sm-8">@Model.Probability%</dd>

                    <dt class="col-sm-4 text-muted">Weighted Value:</dt>
                    <dd class="col-sm-8 text-primary fw-bold">$@Model.WeightedAmount.ToString("N2")</dd>

                    <dt class="col-sm-4 text-muted">Expected Close Date:</dt>
                    <dd class="col-sm-8">@Model.ExpectedCloseDate.ToString("yyyy-MM-dd")</dd>

                    <dt class="col-sm-4 text-muted">Status:</dt>
                    <dd class="col-sm-8"><span class="badge bg-secondary">@Model.Status</span></dd>

                    <dt class="col-sm-4 text-muted">Created Date:</dt>
                    <dd class="col-sm-8">@Model.CreatedDate.ToString("F")</dd>
                </dl>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4"><i class="fa-solid fa-arrow-left me-1"></i> Back to List</a>
                    <a href="@Url.Action("Edit", new { id = Model.OpportunityId })" class="btn btn-warning px-4"><i class="fa-solid fa-pen me-1"></i> Edit Opportunity</a>
                </div>
            </div>
        </div>
    </div>
</div>
