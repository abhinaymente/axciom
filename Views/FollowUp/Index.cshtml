@model AcxiomCRM.ViewModels.FollowUpListViewModel
@{
    ViewData["Title"] = "Follow-Up Schedule Management";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold text-dark m-0"><i class="fa-solid fa-calendar-check me-2 text-info"></i>Follow-Up Schedule</h4>
    <a href="@Url.Action("Create")" class="btn btn-info text-white rounded-pill px-3 shadow-sm">
        <i class="fa-solid fa-plus me-1"></i> Schedule Follow-Up
    </a>
</div>

<!-- Search & Filter Card -->
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-5">
                <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Search by Remarks, Customer, Lead..." />
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- All Statuses --</option>
                    <option value="Planned" selected="@(Model.StatusFilter == "Planned")">Planned</option>
                    <option value="Completed" selected="@(Model.StatusFilter == "Completed")">Completed</option>
                    <option value="Missed" selected="@(Model.StatusFilter == "Missed")">Missed</option>
                    <option value="Cancelled" selected="@(Model.StatusFilter == "Cancelled")">Cancelled</option>
                </select>
            </div>
            <div class="col-md-2">
                <select name="type" class="form-select">
                    <option value="">-- All Types --</option>
                    <option value="Call" selected="@(Model.TypeFilter == "Call")">Call</option>
                    <option value="Meeting" selected="@(Model.TypeFilter == "Meeting")">Meeting</option>
                    <option value="Email" selected="@(Model.TypeFilter == "Email")">Email</option>
                    <option value="Task" selected="@(Model.TypeFilter == "Task")">Task</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary w-100"><i class="fa-solid fa-filter me-1"></i> Filter</button>
                <a href="@Url.Action("Index")" class="btn btn-outline-secondary"><i class="fa-solid fa-rotate-right"></i></a>
            </div>
        </form>
    </div>
</div>

<!-- Follow-Up Table -->
<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Type</th>
                        <th>Scheduled Date/Time</th>
                        <th>Target (Customer / Lead)</th>
                        <th>Remarks</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.FollowUps.Any())
                    {
                        foreach (var f in Model.FollowUps)
                        {
                            <tr>
                                <td><span class="badge bg-secondary">@f.FollowUpType</span></td>
                                <td class="fw-semibold">@f.FollowUpDate.ToString("g")</td>
                                <td>@(f.Customer?.CustomerName ?? f.Lead?.LeadName ?? "-")</td>
                                <td>@(f.Remarks ?? "-")</td>
                                <td>
                                    @{
                                        string bgClass = f.Status switch
                                        {
                                            "Planned" => "bg-primary",
                                            "Completed" => "bg-success",
                                            "Missed" => "bg-danger",
                                            "Cancelled" => "bg-secondary",
                                            _ => "bg-info"
                                        };
                                    }
                                    <span class="badge @bgClass">@f.Status</span>
                                </td>
                                <td class="text-end">
                                    <a href="@Url.Action("Edit", new { id = f.FollowUpId })" class="btn btn-sm btn-outline-warning me-1" title="Edit / Reschedule"><i class="fa-solid fa-pen"></i></a>
                                    <form asp-action="Delete" asp-route-id="@f.FollowUpId" method="post" class="d-inline" onsubmit="return confirm('Delete this follow-up entry?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="fa-solid fa-trash"></i></button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">No follow-ups scheduled matching the criteria.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (Model.TotalPages > 1)
{
    <nav class="mt-4">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="@Url.Action("Index", new { page = i, search = Model.SearchTerm, status = Model.StatusFilter, type = Model.TypeFilter })">@i</a>
                </li>
            }
        </ul>
    </nav>
}
