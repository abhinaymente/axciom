@model IEnumerable<AcxiomCRM.Models.Customer>
@{
    ViewData["Title"] = "Customer Management Report";
}

<h4 class="fw-bold text-dark mb-3"><i class="fa-solid fa-chart-pie me-2 text-primary"></i>CRM Reports</h4>
@await Html.PartialAsync("_ReportNav")

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <input type="hidden" name="reportType" value="Customer" />
            <div class="col-md-7">
                <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search report data..." />
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- Filter Status --</option>
                    <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Active</option>
                    <option value="Inactive" selected="@(ViewBag.StatusFilter == "Inactive")">Inactive</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100"><i class="fa-solid fa-search me-1"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold m-0 text-primary">Customer Summary Report (@Model.Count() records)</h6>
        <button onclick="window.print()" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-print me-1"></i> Print / PDF</button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Code</th>
                        <th>Name</th>
                        <th>Company</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <th>Location</th>
                        <th>Status</th>
                        <th>Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@c.CustomerCode</td>
                            <td class="fw-bold">@c.CustomerName</td>
                            <td>@(c.CompanyName ?? "-")</td>
                            <td>@c.Email</td>
                            <td>@c.Phone</td>
                            <td>@c.City, @c.State</td>
                            <td><span class="badge @(c.Status == "Active" ? "bg-success" : "bg-danger")">@c.Status</span></td>
                            <td>@c.CreatedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
