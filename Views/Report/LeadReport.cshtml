@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Lead Summary Report";
}

<h4 class="fw-bold text-dark mb-3"><i class="fa-solid fa-chart-pie me-2 text-warning"></i>CRM Reports</h4>
@await Html.PartialAsync("_ReportNav")

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <input type="hidden" name="reportType" value="Lead" />
            <div class="col-md-7">
                <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search lead report data..." />
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- All Lead Statuses --</option>
                    <option value="New" selected="@(ViewBag.StatusFilter == "New")">New</option>
                    <option value="Contacted" selected="@(ViewBag.StatusFilter == "Contacted")">Contacted</option>
                    <option value="Qualified" selected="@(ViewBag.StatusFilter == "Qualified")">Qualified</option>
                    <option value="Lost" selected="@(ViewBag.StatusFilter == "Lost")">Lost</option>
                    <option value="Converted" selected="@(ViewBag.StatusFilter == "Converted")">Converted</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-warning text-dark w-100"><i class="fa-solid fa-search me-1"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold m-0 text-warning">Lead Summary Report (@Model.Count() records)</h6>
        <button onclick="window.print()" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-print me-1"></i> Print / PDF</button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Lead Code</th>
                        <th>Lead Name</th>
                        <th>Company</th>
                        <th>Email / Phone</th>
                        <th>Source</th>
                        <th>Expected Value</th>
                        <th>Status</th>
                        <th>Created Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@l.LeadCode</td>
                            <td class="fw-bold">@l.LeadName</td>
                            <td>@(l.CompanyName ?? "-")</td>
                            <td>@l.Email | @l.Phone</td>
                            <td>@l.Source</td>
                            <td class="fw-bold text-success">$@l.ExpectedValue.ToString("N0")</td>
                            <td><span class="badge bg-warning text-dark">@l.Status</span></td>
                            <td>@l.CreatedDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
