@model IEnumerable<AcxiomCRM.Models.Activity>
@{
    ViewData["Title"] = "User Sales Activity Report";
}

<h4 class="fw-bold text-dark mb-3"><i class="fa-solid fa-clock-rotate-left me-2 text-primary"></i>CRM Reports</h4>
@await Html.PartialAsync("_ReportNav")

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold m-0 text-primary">Sales Activity Log Report (@Model.Count() records)</h6>
        <button onclick="window.print()" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-print me-1"></i> Print / PDF</button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Type</th>
                        <th>Subject</th>
                        <th>Date/Time</th>
                        <th>Target (Customer/Lead)</th>
                        <th>Description</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td><span class="badge bg-secondary">@a.ActivityType</span></td>
                            <td class="fw-bold">@a.Subject</td>
                            <td>@a.ActivityDate.ToString("g")</td>
                            <td>@(a.Customer?.CustomerName ?? a.Lead?.LeadName ?? "-")</td>
                            <td>@(a.Description ?? "-")</td>
                            <td><span class="badge bg-success">@a.Status</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
