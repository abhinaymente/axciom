@model IEnumerable<AcxiomCRM.Models.Lead>
@{
    ViewData["Title"] = "Lead Conversion Report";
}

<h4 class="fw-bold text-dark mb-3"><i class="fa-solid fa-arrow-right-to-bracket me-2 text-success"></i>CRM Reports</h4>
@await Html.PartialAsync("_ReportNav")

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold m-0 text-success">Converted Leads Report (@Model.Count() conversions)</h6>
        <button onclick="window.print()" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-print me-1"></i> Print / PDF</button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Lead Code</th>
                        <th>Lead Name</th>
                        <th>Converted Customer</th>
                        <th>Converted Opportunity</th>
                        <th>Expected Value</th>
                        <th>Source</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var l in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@l.LeadCode</td>
                            <td class="fw-bold">@l.LeadName</td>
                            <td>@(l.ConvertedCustomer?.CustomerName ?? "-")</td>
                            <td>@(l.ConvertedOpportunity?.OpportunityName ?? "-")</td>
                            <td class="fw-bold text-success">$@l.ExpectedValue.ToString("N0")</td>
                            <td>@l.Source</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
