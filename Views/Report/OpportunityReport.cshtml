@model IEnumerable<AcxiomCRM.Models.Opportunity>
@{
    ViewData["Title"] = "Opportunity Sales Report";
}

<h4 class="fw-bold text-dark mb-3"><i class="fa-solid fa-chart-pie me-2 text-success"></i>CRM Reports</h4>
@await Html.PartialAsync("_ReportNav")

<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <input type="hidden" name="reportType" value="Opportunity" />
            <div class="col-md-7">
                <input type="text" name="search" value="@ViewBag.SearchTerm" class="form-control" placeholder="Search opportunity report data..." />
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- All Statuses --</option>
                    <option value="Active" selected="@(ViewBag.StatusFilter == "Active")">Active</option>
                    <option value="Won" selected="@(ViewBag.StatusFilter == "Won")">Won</option>
                    <option value="Lost" selected="@(ViewBag.StatusFilter == "Lost")">Lost</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-success w-100"><i class="fa-solid fa-search me-1"></i> Filter</button>
            </div>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-header bg-white border-0 pt-3 px-4 d-flex justify-content-between align-items-center">
        <h6 class="fw-bold m-0 text-success">Opportunity Performance Report (@Model.Count() records)</h6>
        <button onclick="window.print()" class="btn btn-sm btn-outline-secondary"><i class="fa-solid fa-print me-1"></i> Print / PDF</button>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-bordered table-striped align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Opportunity Name</th>
                        <th>Target Customer/Lead</th>
                        <th>Amount</th>
                        <th>Stage</th>
                        <th>Probability</th>
                        <th>Weighted Value</th>
                        <th>Expected Close</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var o in Model)
                    {
                        <tr>
                            <td class="fw-bold">@o.OpportunityName</td>
                            <td>@(o.Customer?.CustomerName ?? o.Lead?.LeadName ?? "-")</td>
                            <td class="fw-bold text-dark">$@o.Amount.ToString("N0")</td>
                            <td><span class="badge bg-success">@o.Stage</span></td>
                            <td>@o.Probability%</td>
                            <td class="fw-bold text-primary">$@o.WeightedAmount.ToString("N0")</td>
                            <td>@o.ExpectedCloseDate.ToString("yyyy-MM-dd")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
