@model AcxiomCRM.ViewModels.UserEditViewModel
@{
    ViewData["Title"] = "Edit User - " + Model.Email;
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h4 class="fw-bold m-0 text-danger"><i class="fa-solid fa-user-pen me-2"></i>Edit User Permissions</h4>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="Email" />
                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label class="form-label text-muted">Email Address (Read-only)</label>
                        <input value="@Model.Email" class="form-control bg-light" readonly />
                    </div>

                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                        <input asp-for="FullName" class="form-control" required />
                        <span asp-validation-for="FullName" class="text-danger fs-7"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Department" class="form-label fw-semibold"></label>
                            <input asp-for="Department" class="form-control" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Role" class="form-label fw-semibold"></label> <span class="text-danger">*</span>
                            <select asp-for="Role" class="form-select" required>
                                @if (ViewBag.Roles != null)
                                {
                                    foreach (var r in (List<string>)ViewBag.Roles)
                                    {
                                        <option value="@r" selected="@(Model.Role == r)">@r</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input asp-for="IsActive" class="form-check-input" id="chkActive" />
                        <label class="form-check-label fw-bold" for="chkActive">Account Active Status</label>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label fw-semibold"></label>
                        <input asp-for="NewPassword" type="password" class="form-control" placeholder="Leave blank to keep existing password" />
                    </div>

                    <div class="d-flex justify-content-end gap-2 mt-4">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-danger px-4"><i class="fa-solid fa-save me-1"></i> Save Changes</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
