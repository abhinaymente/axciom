@model AcxiomCRM.Models.Customer
@{
    ViewData["Title"] = "Customer Details - " + Model.CustomerName;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                <h4 class="fw-bold m-0"><i class="fa-solid fa-address-card text-info me-2"></i>@Model.CustomerName</h4>
                <span class="badge @(Model.Status == "Active" ? "bg-success" : "bg-danger") px-3 py-2">@Model.Status</span>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 fs-6">
                    <dt class="col-sm-4 text-muted">Customer Code:</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.CustomerCode</dd>

                    <dt class="col-sm-4 text-muted">Company Name:</dt>
                    <dd class="col-sm-8">@(Model.CompanyName ?? "-")</dd>

                    <dt class="col-sm-4 text-muted">Email Address:</dt>
                    <dd class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                    <dt class="col-sm-4 text-muted">Phone Number:</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>

                    <dt class="col-sm-4 text-muted">Street Address:</dt>
                    <dd class="col-sm-8">@(Model.Address ?? "-")</dd>

                    <dt class="col-sm-4 text-muted">City / State:</dt>
                    <dd class="col-sm-8">@(Model.City ?? "-"), @(Model.State ?? "-")</dd>

                    <dt class="col-sm-4 text-muted">Created Date:</dt>
                    <dd class="col-sm-8">@Model.CreatedDate.ToString("F")</dd>
                </dl>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4"><i class="fa-solid fa-arrow-left me-1"></i> Back to List</a>
                    <a href="@Url.Action("Edit", new { id = Model.CustomerId })" class="btn btn-warning px-4"><i class="fa-solid fa-pen me-1"></i> Edit Customer</a>
                </div>
            </div>
        </div>
    </div>
</div>
