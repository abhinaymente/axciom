@model AcxiomCRM.Models.Lead
@{
    ViewData["Title"] = "Lead Details - " + Model.LeadName;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4 d-flex justify-content-between align-items-center">
                <h4 class="fw-bold m-0"><i class="fa-solid fa-filter text-warning me-2"></i>@Model.LeadName</h4>
                <span class="badge bg-warning text-dark px-3 py-2">@Model.Status</span>
            </div>
            <div class="card-body p-4">
                <dl class="row mb-0 fs-6">
                    <dt class="col-sm-4 text-muted">Lead Code:</dt>
                    <dd class="col-sm-8 fw-semibold">@Model.LeadCode</dd>

                    <dt class="col-sm-4 text-muted">Company Name:</dt>
                    <dd class="col-sm-8">@(Model.CompanyName ?? "-")</dd>

                    <dt class="col-sm-4 text-muted">Email Address:</dt>
                    <dd class="col-sm-8"><a href="mailto:@Model.Email">@Model.Email</a></dd>

                    <dt class="col-sm-4 text-muted">Phone Number:</dt>
                    <dd class="col-sm-8">@Model.Phone</dd>

                    <dt class="col-sm-4 text-muted">Lead Source:</dt>
                    <dd class="col-sm-8">@Model.Source</dd>

                    <dt class="col-sm-4 text-muted">Expected Deal Value:</dt>
                    <dd class="col-sm-8 text-success fw-bold">$@Model.ExpectedValue.ToString("N2")</dd>

                    <dt class="col-sm-4 text-muted">Created Date:</dt>
                    <dd class="col-sm-8">@Model.CreatedDate.ToString("F")</dd>
                </dl>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4"><i class="fa-solid fa-arrow-left me-1"></i> Back to List</a>
                    @if (Model.Status != "Converted")
                    {
                        <a href="@Url.Action("Convert", new { id = Model.LeadId })" class="btn btn-success px-4"><i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Convert Lead</a>
                    }
                    <a href="@Url.Action("Edit", new { id = Model.LeadId })" class="btn btn-warning px-4"><i class="fa-solid fa-pen me-1"></i> Edit Lead</a>
                </div>
            </div>
        </div>
    </div>
</div>
