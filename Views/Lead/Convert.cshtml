@model AcxiomCRM.ViewModels.LeadConvertViewModel
@{
    ViewData["Title"] = "Convert Lead - " + Model.LeadName;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-header bg-white border-0 pt-4 px-4">
                <h4 class="fw-bold m-0 text-success"><i class="fa-solid fa-arrow-right-to-bracket me-2"></i>Convert Lead to Customer &amp; Opportunity</h4>
                <p class="text-muted fs-6 mb-0 mt-1">Lead: <strong>@Model.LeadName</strong> (@Model.Email)</p>
            </div>
            <div class="card-body p-4">
                <form asp-action="Convert" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="LeadId" />
                    <input type="hidden" asp-for="LeadName" />
                    <input type="hidden" asp-for="Email" />
                    <input type="hidden" asp-for="Phone" />

                    <div asp-validation-summary="All" class="text-danger mb-3"></div>

                    <!-- Step 1: Customer Creation -->
                    <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="CreateCustomer" class="form-check-input" id="chkCustomer" />
                            <label class="form-check-label fw-bold text-dark" for="chkCustomer">Create / Link Account Customer</label>
                        </div>
                        <div class="mb-2">
                            <label asp-for="CustomerName" class="form-label fw-semibold"></label>
                            <input asp-for="CustomerName" class="form-control" />
                        </div>
                    </div>

                    <!-- Step 2: Opportunity Creation -->
                    <div class="card bg-light border-0 p-3 mb-4 rounded-3">
                        <div class="form-check form-switch mb-2">
                            <input asp-for="CreateOpportunity" class="form-check-input" id="chkOpp" />
                            <label class="form-check-label fw-bold text-dark" for="chkOpp">Create Sales Opportunity</label>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="OpportunityName" class="form-label fw-semibold"></label>
                                <input asp-for="OpportunityName" class="form-control" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="OpportunityAmount" class="form-label fw-semibold"></label>
                                <input asp-for="OpportunityAmount" type="number" step="0.01" class="form-control" required />
                                <span asp-validation-for="OpportunityAmount" class="text-danger fs-7"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Stage" class="form-label fw-semibold"></label>
                                <select asp-for="Stage" class="form-select">
                                    <option value="Qualification">Qualification</option>
                                    <option value="Proposal">Proposal</option>
                                    <option value="Negotiation">Negotiation</option>
                                    <option value="Won">Won</option>
                                    <option value="Lost">Lost</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Probability" class="form-label fw-semibold"></label>
                                <input asp-for="Probability" type="number" min="0" max="100" class="form-control" required />
                                <span asp-validation-for="Probability" class="text-danger fs-7"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="ExpectedCloseDate" class="form-label fw-semibold"></label>
                                <input asp-for="ExpectedCloseDate" type="date" class="form-control" required />
                                <span asp-validation-for="ExpectedCloseDate" class="text-danger fs-7"></span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a href="@Url.Action("Index")" class="btn btn-outline-secondary px-4">Cancel</a>
                        <button type="submit" class="btn btn-success px-4 py-2"><i class="fa-solid fa-check me-1"></i> Confirm Conversion</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
